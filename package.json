{
    "name": "agentic-playwright",
    "version": "0.1.0",
    "private": true,
    "description": "Playwright + TypeScript test automation framework with AI-assisted development rules for Claude Code.",
    "scripts": {
        "test": "npx playwright test --grep-invert @destructive",
        "test:chromium": "npx playwright test --project=chromium --grep-invert @destructive",
        "test:admin": "npx playwright test --project=chromium-admin --grep-invert @destructive",
        "test:firefox": "npx playwright test --project=firefox --grep-invert @destructive",
        "test:webkit": "npx playwright test --project=webkit --grep-invert @destructive",
        "test:ci": "npx playwright test --project=chromium --project=chromium-admin --workers=1",
        "test:debug": "npx playwright test --project=chromium --debug",
        "test:ui": "npx playwright test --project=chromium --ui",
        "test:headed": "npx playwright test --project=chromium --headed --grep-invert @destructive",
        "test:smoke": "npx playwright test --grep @smoke --project=chromium --project=chromium-admin",
        "test:regression": "npx playwright test --grep @regression --project=chromium --project=chromium-admin",
        "test:api": "npx playwright test --project=api",
        "test:e2e": "npx playwright test --grep @e2e --project=chromium --project=chromium-admin",
        "test:destructive": "npx playwright test --grep @destructive --project=chromium --project=chromium-admin --workers=1",
        "report": "npx playwright show-report",
        "lint": "npx eslint .",
        "lint:fix": "npx eslint . --fix",
        "format": "npx prettier --write .",
        "setup:check": "node -e \"const [a, b, c] = process.versions.node.split('.').map(Number); if (a < 22 || (a === 22 && (b < 22 || (b === 22 && c < 1)))) { console.error('Node >= 22.22.1 required, found ' + process.version); process.exit(1); }\" && npx playwright cli --version && echo 'All checks passed'",
        "check:skills-drift": "bash scripts/check-rules-drift.sh",
        "check:skills-references": "bash scripts/check-skill-references-drift.sh",
        "check:skills-crossrefs": "bash scripts/check-skill-crossrefs.sh",
        "check:skills": "npm run check:skills-drift && npm run check:skills-references && npm run check:skills-crossrefs",
        "skills:sync-cli": "node scripts/sync-playwright-cli-skill.js",
        "postinstall": "is-ci || husky"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.5.0",
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.2.0",
        "@typescript-eslint/eslint-plugin": "^8.66.0",
        "@typescript-eslint/parser": "^8.34.1",
        "eslint": "^10.8.1",
        "eslint-plugin-playwright": "^2.11.0",
        "eslint-plugin-prettier": "^5.5.6",
        "husky": "^9.1.7",
        "is-ci": "^4.1.0",
        "jiti": "^2.7.0",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.9"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "zod": "^4.4.3"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "npx eslint --fix",
            "npx prettier --write"
        ],
        "*.{md,json}": "npx prettier --write"
    },
    "engines": {
        "node": ">=22.22.1"
    }
}
